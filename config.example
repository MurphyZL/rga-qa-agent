APP_NAME=rag-qa-agent
APP_HOST=127.0.0.1
APP_PORT=8010

# 试运行共享 Token，调用 /api/* 时必须携带（Bearer 或 X-AI-Agent-Token）
AI_AGENT_API_TOKEN=change-me-trial-token

# CORS 白名单，逗号分隔；请按实际前端域名补充
CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8010,http://localhost:8010

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag_knowledge

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TOP_K=8
RERANK_TOP_N=4
# 试运行默认开启权限过滤
ENFORCE_PERMISSION_FILTER=true
# 试运行默认关闭启动全量重建索引，知识变更后请手动 /api/reindex
AUTO_REINDEX_ON_STARTUP=false
# CrossEncoder 重排最高分低于该值则拒答（bge-reranker 分数可小于 0）
MIN_RERANK_SCORE=-2.0

KNOWLEDGE_PATH=data/knowledge.json
